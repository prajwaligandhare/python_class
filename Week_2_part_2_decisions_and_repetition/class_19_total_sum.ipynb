   "source": [
    "User se numbers maangte raho jab tak woh \"stop\" na likhe; phir total sum print karo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5dcb6ece",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total: 47\n"
     ]
    }
   ],
   "source": [
    "total = 0\n",
    "while True:\n",
    "    entry = input(\"Enter a number (or 'stop'): \")\n",
    "    if entry == 'stop':\n",
    "        break\n",
    "    total = total + int(entry)\n",
    "print(f\"Total: {total}\")\n",
    "    "
   ]
  }
